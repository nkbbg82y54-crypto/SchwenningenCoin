<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Schwenningen Token | Community Token auf Solana</title>

<style>

:root{
  --gold:#f3bf2b;
  --gold2:#ffdd75;
  --bg:#050505;
  --card:#0d0d0d;
  --text:#ffffff;
  --muted:#bdbdbd;
  --border:rgba(243,191,43,.22);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,sans-serif;
  background:
    linear-gradient(rgba(0,0,0,.82),rgba(0,0,0,.92)),
    url("assets/poster.jpg") center/cover fixed;
  color:var(--text);
  overflow-x:hidden;
}

a{
  text-decoration:none;
  color:inherit;
}

section{
  padding:110px 24px;
  max-width:1250px;
  margin:auto;
}

.section-title{
  text-align:center;
  margin-bottom:60px;
}

.section-title h2{
  font-size:48px;
  margin-bottom:16px;
  color:var(--gold);
}

.section-title p{
  color:var(--muted);
  max-width:700px;
  margin:auto;
  line-height:1.7;
}

header{
  position:fixed;
  top:0;
  width:100%;
  z-index:1000;
  backdrop-filter:blur(12px);
  background:rgba(0,0,0,.75);
  border-bottom:1px solid rgba(255,255,255,.06);
}

nav{
  max-width:1250px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 24px;
}

.logo{
  display:flex;
  align-items:center;
  gap:14px;
  font-weight:800;
  font-size:20px;
}

.logo img{
  width:52px;
  height:52px;
  border-radius:50%;
}

.nav-links{
  display:flex;
  gap:28px;
  color:#d6d6d6;
  font-size:15px;
}

.nav-links a:hover{
  color:var(--gold);
}

.hero{
  min-height:100vh;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:60px;
  padding-top:140px;
}

.hero-badge{
  display:inline-block;
  padding:10px 18px;
  border-radius:999px;
  background:rgba(243,191,43,.12);
  border:1px solid rgba(243,191,43,.3);
  color:var(--gold2);
  margin-bottom:24px;
  font-size:14px;
  letter-spacing:.6px;
}

.hero h1{
  font-size:clamp(56px,8vw,110px);
  line-height:.95;
  margin-bottom:24px;
  font-weight:900;
}

.hero h1 span{
  color:var(--gold);
}

.hero p{
  color:var(--muted);
  font-size:22px;
  line-height:1.7;
  max-width:620px;
  margin-bottom:34px;
}

.hero-buttons{
  display:flex;
  gap:18px;
  flex-wrap:wrap;
}

.btn{
  padding:15px 28px;
  border-radius:14px;
  background:linear-gradient(135deg,var(--gold2),var(--gold));
  color:#111;
  font-weight:800;
}

.btn-outline{
  border:1px solid rgba(255,255,255,.18);
  padding:15px 28px;
  border-radius:14px;
  color:#fff;
  background:rgba(255,255,255,.04);
}

.coin{
  width:100%;
  max-width:560px;
  display:block;
  margin:auto;
  filter:
    drop-shadow(0 0 25px rgba(243,191,43,.35))
    drop-shadow(0 40px 80px rgba(0,0,0,.75));
}

.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:24px;
}

.card{
  background:rgba(8,8,8,.82);
  border:1px solid var(--border);
  border-radius:24px;
  padding:34px 26px;
  text-align:center;
}

.card h3{
  color:var(--gold);
  margin-bottom:14px;
  font-size:24px;
}

.card p{
  color:var(--muted);
  line-height:1.7;
}

.story{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:42px;
  align-items:center;
}

.story img{
  width:100%;
  border-radius:30px;
  border:1px solid var(--border);
}

.story-box{
  background:rgba(8,8,8,.78);
  border:1px solid var(--border);
  padding:44px;
  border-radius:30px;
}

.story-box h2{
  font-size:48px;
  margin-bottom:24px;
  color:var(--gold);
}

.story-box p{
  color:var(--muted);
  line-height:1.9;
  margin-bottom:18px;
  font-size:18px;
}

.tokenomics{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:22px;
}

.token-box{
  background:rgba(8,8,8,.82);
  border:1px solid var(--border);
  border-radius:24px;
  padding:36px;
  text-align:center;
}

.token-box strong{
  display:block;
  font-size:42px;
  color:var(--gold);
  margin-bottom:10px;
}

.token-box span{
  color:var(--muted);
}

.address{
  margin-top:34px;
  background:rgba(8,8,8,.82);
  border:1px dashed rgba(243,191,43,.4);
  border-radius:22px;
  padding:26px;
  text-align:center;
  color:#d7d7d7;
  word-break:break-all;
  font-size:17px;
}

.faq{
  display:grid;
  gap:18px;
}

.faq-item{
  background:rgba(8,8,8,.82);
  border:1px solid var(--border);
  border-radius:20px;
  padding:28px;
}

.faq-item h3{
  color:var(--gold);
  margin-bottom:10px;
}

.faq-item p{
  color:var(--muted);
  line-height:1.7;
}

.disclaimer{
  background:rgba(243,191,43,.08);
  border:1px solid rgba(243,191,43,.35);
  border-radius:24px;
  padding:36px;
  margin-top:50px;
}

.disclaimer h3{
  color:var(--gold);
  margin-bottom:14px;
  font-size:28px;
}

.disclaimer p{
  color:#dddddd;
  line-height:1.8;
}

footer{
  border-top:1px solid rgba(255,255,255,.08);
  padding:50px 24px;
  text-align:center;
  color:#8f8f8f;
  background:#050505;
}

footer a{
  color:var(--gold);
}

@media(max-width:980px){

.hero,
.story{
  grid-template-columns:1fr;
  text-align:center;
}

.cards,
.tokenomics{
  grid-template-columns:1fr;
}

.hero-buttons{
  justify-content:center;
}

.nav-links{
  display:none;
}

}

</style>
</head>

